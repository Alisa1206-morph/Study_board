@model Study_board.Models.ViewModels.Checklists.ChecklistViewModel

@{
    ViewData["Title"] = "Details";

    var mainImage = Model.Image;
}

<div class="container mt-4">
    <h1>@Model.Title</h1>
    <hr />

    <div class="row mb-5">
        <div class="col-md-6 mb-4 mb-md-0">
            @if (mainImage != null)
            {
                <div class="card shadow-lg border-0 rounded overflow-hidden">
                    <img src="@mainImage.ImagePath"
                         class="img-fluid w-100"
                         style="height: 400px; object-fit: cover;"
                         alt="@Model.Title Image">
                </div>
            }
            else
            {
                <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded shadow-sm" style="height: 400px;">
                    <span class="h3">No Image Available</span>
                </div>
            }
        </div>

        <div class="col-md-6">
            <div class="card border-0 bg-light h-100">
                <div class="card-body">
                    <h4 class="card-title text-primary mb-4">About @Model.Title</h4>

                    <dl class="row">
                        <dt class="col-sm-4 text-muted">
                            @Html.DisplayNameFor(model => model.Title)
                        </dt>
                        <dd class="col-sm-8 fw-bold">
                            @Html.DisplayFor(model => model.Title)
                        </dd>
                    </dl>

                    <div class="mt-4">
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary px-4">
                            <i class="bi bi-pencil-square"></i> Edit
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Back</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

@if (Model.Projects != null && Model.Projects.Any())
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Associated Projects</h5>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var project in Model.Projects)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>
                            <i class="bi bi-folder2-open me-2"></i>
                            @project.Name
                        </span>
                        <a asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id" class="btn btn-sm btn-outline-primary">
                            View Details
                        </a>
                    </li>
                }
            </ul>
        </div>
    }
</div>